// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- BESTUUR / STICHTING ----------

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#3D2467")
  accentColor  String   @default("#E8B44A")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  config           SchoolConfig?
  schools          School[]
  users            User[]
  classGroups      ClassGroup[]
  weekPlans        WeekPlan[]
  groupReflections GroupReflection[]
  clusterPlans     ClusterPlan[]
  qualityGoals     QualityGoal[]
  schoolResults    SchoolResult[]
}

model SchoolConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  aiProvider        String @default("gemini")
  microAnalyseLabel String @default("Micro-analyse")
  qualityFramework  String @default("SLO-kerndoelen")

  // Fase-4 feature flags (structuur nu, features later)
  studentDataMode             String  @default("NONE") // NONE | ANONYMOUS_GROUP_ONLY | PSEUDONYMIZED | IDENTIFIABLE
  parnasSysEnabled            Boolean @default(false)
  oppSupportEnabled           Boolean @default(false)
  studentLevelAnalysisEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- SCHOOL ----------

model School {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  code String @unique // "SGS", "SSS", "SKS", "SVS", "SLS"

  // Roostertype als label / onboarding-sjabloon. De ECHTE tijden per weekdag
  // (incl. pauzes) staan in SchoolDaySchedule — dat is de bron van waarheid.
  rosterType RosterType @default(TRADITIONAL) // label: TRADITIONAL | CONTINUOUS | CUSTOM

  users            User[]
  classGroups      ClassGroup[]
  methods          SchoolMethod[]
  scheduleItems    ScheduleItem[]
  daySchedules     SchoolDaySchedule[]
  weekPlans        WeekPlan[]
  groupReflections GroupReflection[]
  clusterPlans     ClusterPlan[]
  schoolResults    SchoolResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RosterType {
  TRADITIONAL // klassiek: aparte middagpauze, woensdag vaak half
  CONTINUOUS // continurooster: korte pauze, iedereen blijft over
  CUSTOM // afwijkend / vrij
}

// Dagschema per school: de echte tijden per weekdag, inclusief pauze.
// Eén rij per (school, dag). Geen rij = die dag geen school.
// Bron van waarheid voor de AI-weekplanner (start/eind/pauze per dag).
model SchoolDaySchedule {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  dayOfWeek  Weekday
  startTime  String // "08:30"
  endTime    String // "15:00"
  breakStart String? // begin middagpauze; null = geen aparte pauze
  breakEnd   String? // eind middagpauze

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, dayOfWeek])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

// ---------- GEBRUIKERS ----------

model User {
  id                    String                 @id
  organizationId        String?
  organization          Organization?          @relation(fields: [organizationId], references: [id])
  schoolId              String?
  school                School?                @relation(fields: [schoolId], references: [id])
  role                  Role                   @default(TEACHER)
  // VEROUDERD: vrij tekstveld uit de registratie. De echte koppeling
  // leerkracht <-> groep loopt via ClassGroupMembership. Wordt verwijderd
  // zodra de registratie/onboarding een ClassGroup laat kiezen.
  groep                 String?
  name                  String
  email                 String
  emailVerified         Boolean                @default(false)
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  accounts              Account[]
  weekPlans             WeekPlan[]
  groupReflections      GroupReflection[]
  clusterPlansCreated   ClusterPlan[]          @relation("ClusterPlanCreatedBy")
  clusterPlansFixed     ClusterPlan[]          @relation("ClusterPlanVastgesteldDoor")
  classGroupMemberships ClassGroupMembership[]

  @@unique([email])
  @@map("user")
}

// Rol bepaalt WAT iemand mag; de scope (schoolId / organizationId /
// ClassGroupMembership) bepaalt WAARover. Server-side afgedwongen in lib/access.ts.
enum Role {
  TEACHER // eigen groepen (via ClassGroupMembership)
  IB // intern begeleider: alle groepen eigen school, lezen + ondersteunen
  SCHOOL_ADMIN // directeur/schoolleiding: alle groepen eigen school + beheer
  QUALITY_STAFF // bovenschools kwaliteitsmedewerker: inhoudelijk, alle scholen van het bestuur
  BOARD // bestuur/RvT/bestuursbureau: meso/trend, anonieme aggregaties
  PLATFORM_ADMIN // Klasmaatje-beheer: alles
}

// ---------- GROEPEN (KLASSEN) ----------

// Een groep zoals de school die kent: "6A", "3/4", "1/2B". Hoort bij één school
// en één schooljaar; volgend schooljaar = nieuwe ClassGroup (historie blijft
// intact, oude WeekPlans blijven aan de oude groep hangen).
// Bevat GEEN leerlinggegevens.
model ClassGroup {
  id             String       @id @default(cuid())
  organizationId String // tenant-scope; moet gelijk zijn aan school.organizationId (gecontroleerd in lib/access.ts)
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])

  name       String // weergavenaam zoals de school 'm gebruikt: "6A", "3/4"
  grades     Int[] // leerjaren 1-8; combiklas = [3, 4]. Matcht ScheduleItem.targetGrades
  schoolYear String // "2026/2027" (zelfde notatie als SchoolResult.schooljaar)

  memberships      ClassGroupMembership[]
  weekPlans        WeekPlan[]
  groupReflections GroupReflection[]
  clusterPlans     ClusterPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, schoolYear, name])
  @@index([organizationId])
}

// Wie werkt actief in deze groep (many-to-many). Een leerkracht kan meerdere
// groepen hebben; een groep meerdere leerkrachten (duo, invaller).
// IB/directie/kwaliteit krijgen inzage via rol + scope, NIET via membership.
model ClassGroupMembership {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  role         ClassGroupRole @default(GROUP_TEACHER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, classGroupId])
  @@index([classGroupId])
}

enum ClassGroupRole {
  GROUP_TEACHER // groepsleerkracht (ook duo-partner)
  SUBSTITUTE // invaller
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- METHODE-CATALOGUS ----------

model Method {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  description String?
  subjectArea String?
  publisher   String?
  sloMapping  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools   SchoolMethod[]
  weekPlans WeekPlan[]
}

model SchoolMethod {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  methodId  String
  method    Method   @relation(fields: [methodId], references: [id])
  createdAt DateTime @default(now())

  @@unique([schoolId, methodId])
}

// ---------- MIJN WEEK ----------

model ScheduleItem {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  label        String
  defaultTime  String?
  category     String  @default("routine")
  aiHint       String?
  sortOrder    Int     @default(0)
  // Voor welke LEERJAREN (1-8) dit vaste item geldt, bv. [1, 2] voor
  // kleuterkring. Leeg = geldt voor alle leerjaren. Let op: leerjaar, niet
  // de groepsnaam ("6A") — die staat op ClassGroup.
  targetGrades Int[]   @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeekPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  classGroupId   String
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id])
  userId         String // maker van het plan (leerkracht)
  user           User         @relation(fields: [userId], references: [id])
  methodId       String?
  method         Method?      @relation(fields: [methodId], references: [id])

  // `groep` (tekst) vervangen door classGroupId; naam komt uit ClassGroup.name
  periode        String
  thema          String?
  bijzonderheden String?
  status         String  @default("DRAFT")

  lessons     Lesson[]
  reflections GroupReflection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classGroupId])
  @@index([schoolId])
  @@index([organizationId])
}

model Lesson {
  id         String   @id @default(cuid())
  weekPlanId String
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)

  dag                 String
  timeSlot            String?
  type                String  @default("les") // les | toets | routine | viering | oom
  subject             String
  cooperativeStrategy String?

  goalBasis      String?
  goalVerlengd   String?
  goalVerrijking String?

  // Kwaliteitsvelden (uit SHON-trendanalyses)
  targetGroup      String?
  frequency        String?
  materials        String?
  didacticStrategy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- BESTUURS-RESULTATEN (groepsgemiddelden, geen leerlingdata) ----------

model SchoolResult {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])

  leerjaar    String // "5", "6", ...
  vak         String // "CITO DMT", "CITO RW", ...
  toetsmoment String // "M26", "E25", ...
  schooljaar  String // "2025/2026"
  score       Float // groepsgemiddelde
  aantalLln   Int? // aantal leerlingen (context, geen individu)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([schoolId])
}

// ---------- Kwaliteitslaag (fase 2): groepsniveau, GEEN leerlingdata ----------
// Ontwerp: kwaliteitslaag-ontwerpprincipes.md. Planning is geen bewijs;
// uitvoering en effect apart; een mens beoordeelt, de AI stelt hooguit voor.
// Vrije tekst gaat altijd door de privacycontrole (lib/privacy.ts).

// Groepsreflectie (de groepsversie van de micro-analyse): per weekplan per vak.
// Inschatting per niveau door de leerkracht: GEHAALD | DEELS | NOG_NIET (of leeg).
model GroupReflection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  classGroupId   String
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id])
  weekPlanId     String
  weekPlan       WeekPlan     @relation(fields: [weekPlanId], references: [id])
  userId         String // wie de reflectie schreef (groepslid)
  user           User         @relation(fields: [userId], references: [id])

  subject    String // vak, bijv. "Rekenen"
  basis      String? // GEHAALD | DEELS | NOG_NIET
  verlengd   String?
  verrijking String?
  goed       String? // wat ging goed
  aandacht   String? // wat vraagt nog aandacht
  vervolg    String? // wat neem ik mee naar volgende week

  usedInClusterPlans ClusterPlanSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekPlanId, subject])
  @@index([classGroupId])
  @@index([schoolId])
  @@index([organizationId])
}

// Clusterplan: per groep, vak en periode drie instructieclusters.
// Status: DRAFT (concept) -> VASTGESTELD (door IB/directie) -> GEEVALUEERD.
// Effect (JA | DEELS | NEE) vult een mens in bij de evaluatie.
model ClusterPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  classGroupId   String
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id])
  createdById    String
  createdBy      User         @relation("ClusterPlanCreatedBy", fields: [createdById], references: [id])

  subject          String
  startPeriode     String // ISO-week "2026-W45"
  evaluatiePeriode String // ISO-week van het evaluatiemoment
  status           String @default("DRAFT")

  basisDoel        String?
  basisAanpak      String?
  intensiefDoel    String?
  intensiefAanpak  String?
  verrijkingDoel   String?
  verrijkingAanpak String?

  evaluatie String? // wat zie je terug (door een mens)
  effect    String? // JA | DEELS | NEE

  // Optionele koppeling aan een kwaliteitsdoel van het bestuur (PDCA-zicht).
  qualityGoalId String?
  qualityGoal   QualityGoal? @relation(fields: [qualityGoalId], references: [id])

  // Herleidbaarheid: op welke groepsreflecties is dit plan gebaseerd.
  sources ClusterPlanSource[]

  vastgesteldById String?
  vastgesteldDoor User?     @relation("ClusterPlanVastgesteldDoor", fields: [vastgesteldById], references: [id])
  vastgesteldAt   DateTime?
  geevalueerdAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classGroupId])
  @@index([schoolId])
  @@index([organizationId])
  @@index([qualityGoalId])
}

// Kwaliteitsdoel van het bestuur (uit ambitie-/kwaliteitskaarten), per bestuur
// configureerbaar. Bron en letterlijke norm staan erbij; Klasmaatje trekt er
// GEEN conclusies over of de norm gehaald is: het maakt alleen zichtbaar welke
// planning, reflectie en evaluatie bij het doel horen.
model QualityGoal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  code    String // kort en stabiel, bijv. "REK-1F"
  title   String
  source  String // bijv. "Ambitiekaart Rekenen, SBP 2025-2029"
  norm    String? // letterlijke norm uit de bron
  subject String? // vak voor de koppeling met reflecties en clusterplannen

  // Geldigheidsperiode van de norm (kalenderjaren), bijv. SBP 2025-2029.
  validFromYear Int
  validToYear   Int?
  active        Boolean @default(true)

  clusterPlans ClusterPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
}

// Koppeling clusterplan -> groepsreflecties waarop het is gebaseerd.
// Een reflectie die als bron dient, kan niet worden verwijderd (Restrict).
model ClusterPlanSource {
  clusterPlanId String
  clusterPlan   ClusterPlan     @relation(fields: [clusterPlanId], references: [id], onDelete: Cascade)
  reflectionId  String
  reflection    GroupReflection @relation(fields: [reflectionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([clusterPlanId, reflectionId])
  @@index([reflectionId])
}
